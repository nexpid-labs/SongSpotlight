{
	"name": "song-spotlight",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"test": "vitest run",
		"deploy": "wrangler deploy --minify --define IS_PRODUCTION:true",
		"dry-deploy": "bun run deploy --dry-run --outdir=./bundled",
		"format": "dprint fmt",
		"lint": "eslint --fix",
		"typecheck": "wrangler types && tsc --noEmit",
		"make-commands": "bun run --env-file=.dev.vars scripts/commands.ts",
		"make-mockdata": "bun run scripts/mockdata.ts",
		"make-realdata": "bun run scripts/realdata.ts"
	},
	"dependencies": {
		"@hono-rate-limiter/cloudflare": "^0.2.2",
		"@song-spotlight/api": "^2.2.0",
		"discord-api-types": "^0.38.53",
		"discord-interactions": "^4.4.0",
		"hono": "^4.13.4",
		"jose": "^6.2.10",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@eslint/js": "^9.39.5",
		"@types/bun": "^1.4.0",
		"@types/node": "^25.9.5",
		"eslint": "^9.39.5",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-typescript-paths": "^0.0.33",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.11.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11",
		"wrangler": "4.125.0"
	},
	"optionalDependencies": {
		"@resvg/resvg-wasm": "^2.6.2"
	},
	"peerDependencies": {
		"jiti": "^2.7.0"
	},
	"packageManager": "bun@1.3.8",
	"cloudflare": {
		"bindings": {
			"JWT_SECRET": {
				"description": "Randomly generated secret for JWT access tokens, use `openssl rand -hex 32` to generate"
			},
			"JWT_REFRESH_SECRET": {
				"description": "Randomly generated secret for JWT refresh tokens, use `openssl rand -hex 32` to generate"
			},
			"CLIENT_ID": {
				"description": "The Discord OAuth2 application ID"
			},
			"CLIENT_SECRET": {
				"description": "The Discord OAuth2 application secret"
			},
			"REDIRECT_URI": {
				"description": "The Discord OAuth2 application redirect URI"
			},
			"CLIENT_TOKEN": {
				"description": "(Optional) A Discord bot token (prefixed with Bot token type), used for the Silly service"
			},
			"ADMIN_USER_ID": {
				"description": "(Optional) Your Discord user id, used for testing"
			}
		}
	}
}
