{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "songspotlight",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"define": {
		"IS_PRODUCTION": "false"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			// the silly service
			"0 2 * * *"
		]
	},
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		},
		{
			"type": "Text",
			"globs": ["**/*.svg"],
			"fallthrough": true
		}
	],
	"ratelimits": [
		{
			"name": "USER_RATELIMIT",
			"namespace_id": "1001",
			// ratelimit of max 20 requests/10s per user (production)
			"simple": {
				"limit": 20,
				"period": 10
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "VendettaSongSpotlight",
			"database_id": "afee2d05-b13b-4c89-8501-84670cd08d2b",
			"migrations_dir": "migrations"
		}
	]
}
